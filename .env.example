# ── Database ───────────────────────────────────────────────────
# Option A: Local MongoDB (no account needed)
DB_CONNECTION_STRING=mongodb://localhost:27017/citytour

# Option B: MongoDB Atlas (free cloud database)
# DB_CONNECTION_STRING=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/citytour?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────
# Change this to any long random string in production
JWT_SECRET=your_super_secret_key_change_this

# ── Server ─────────────────────────────────────────────────────
PORT=4000
